BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
BETTER_AUTH_URL=https://api.nestflow.art/api/auth
API_BASE_URL=https://api.nestflow.art
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google OAuth redirect URI:
# https://api.nestflow.art/api/auth/callback/google
ZPAY_PID=your_zpay_pid
ZPAY_KEY=your_zpay_key
ZPAY_NOTIFY_BASE_URL=https://api.nestflow.art
ZPAY_RETURN_BASE_URL=https://api.nestflow.art
APP_BASE_URL=https://app.nestflow.art
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
# Comma-separated admin email whitelist (always allowed regardless of plan)
ADMIN_EMAILS=
