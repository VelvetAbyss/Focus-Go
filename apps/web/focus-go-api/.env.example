# Server-only configuration. Copy this file to .env locally or enter the same
# values in your hosting provider's encrypted environment-variable settings.
# Never commit the resulting .env file or paste any value into the Web settings.

# Required in production: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
BETTER_AUTH_URL=https://your-api.example.com/api/auth
API_BASE_URL=https://your-api.example.com
APP_BASE_URL=https://your-app.example.com
# Optional comma-separated Web origins allowed to call this API in addition to
# APP_BASE_URL. Do not use a wildcard for a public deployment.
ALLOWED_ORIGINS=

# Optional: Google sign-in. Create these in Google Cloud Console and add the
# redirect URI https://your-api.example.com/api/auth/callback/google.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Cloud-sync limits. All values are safe to change per deployment.
FREE_SYNC_QUOTA_BYTES=262144000
SYNC_PUSHES_PER_MINUTE=60
SYNC_PULLS_PER_MINUTE=120
# Comma-separated administrator email whitelist.
ADMIN_EMAILS=
