BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
BETTER_AUTH_URL=https://api.nestflow.art/api/auth
API_BASE_URL=https://api.nestflow.art
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google OAuth redirect URI:
# https://api.nestflow.art/api/auth/callback/google
# Free hosted cloud-sync limits. All values are safe to change per deployment.
FREE_SYNC_QUOTA_BYTES=262144000
SYNC_PUSHES_PER_MINUTE=60
SYNC_PULLS_PER_MINUTE=120
# Comma-separated administrator email whitelist.
ADMIN_EMAILS=
# Web Push for task reminders. Optional: without them the server generates a key pair once and
# keeps it in data/vapid-keys.json (persist that directory, or every device must re-subscribe).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nestflow.art
