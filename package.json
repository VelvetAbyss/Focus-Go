{
  "name": "focus-go-monorepo",
  "private": true,
  "version": "0.1.0-beta.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @focus-go/web",
    "dev:desktop": "npm run dev --workspace @focus-go/desktop",
    "dev:screenshot": "pnpm --dir ./apps/ai-screenshot-tool tauri dev",
    "build:web": "npm run build --workspace @focus-go/web",
    "build:desktop": "npm run build --workspace @focus-go/desktop",
    "build:screenshot": "pnpm --dir ./apps/ai-screenshot-tool tauri build --debug --bundles app",
    "lint:web": "npm run lint --workspace @focus-go/web",
    "test:screenshot": "pnpm --dir ./apps/ai-screenshot-tool test",
    "verify": "npm run lint:web && npm run build:web",
    "release:bundle": "node scripts/oss/build-release-bundle.mjs",
    "release:oss:upload": "node scripts/oss/upload-release.mjs",
    "release:oss:verify": "node scripts/oss/verify-release.mjs",
    "release:oss:publish": "npm run release:bundle && npm run release:oss:upload && npm run release:oss:verify",
    "release:oss:restore": "node scripts/oss/restore-release.mjs",
    "release:oss:latest": "node scripts/oss/resolve-latest-release.mjs",
  "social:dry-run": "npm --prefix tools/social-publisher-agent run dry-run",
  "social:weekly": "npm --prefix tools/social-publisher-agent run weekly",
  "social:refresh-week": "npm --prefix tools/social-publisher-agent run refresh-week",
  "social:reset-week-publish": "npm --prefix tools/social-publisher-agent run reset-week-publish",
  "social:publish-week": "npm --prefix tools/social-publisher-agent run publish-week",
  "social:prepare-xhs-aitoearn": "npm --prefix tools/social-publisher-agent run prepare-xhs-aitoearn",
  "social:mark-xhs-aitoearn-scheduled": "npm --prefix tools/social-publisher-agent run mark-xhs-aitoearn-scheduled --",
  "social:set-xhs-hold": "npm --prefix tools/social-publisher-agent run set-xhs-hold --",
  "social:approve": "npm --prefix tools/social-publisher-agent run approve",
    "social:publish-due": "npm --prefix tools/social-publisher-agent run publish-due",
    "social:linkedin:verify": "npm --prefix tools/social-publisher-agent run linkedin:verify",
    "social:xhs-publish": "npm --prefix tools/social-publisher-agent run xhs-publish",
    "social:monday": "npm --prefix tools/social-publisher-agent run monday"
  },
  "devDependencies": {
    "shadcn": "^3.8.5"
  }
}
